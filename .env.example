# --- WhatsApp Cloud API (from Meta Developer Console) ---
WHATSAPP_TOKEN=your_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=pick_any_random_string_you_invent
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id

# --- NVIDIA Nemotron API (from build.nvidia.com) ---
NVIDIA_API_KEY=your_nvidia_api_key

# --- Team notification (optional, for handoff/lead alerts) ---
# Simplest option: a Slack incoming webhook URL, or leave blank to just log to console/file
TEAM_NOTIFY_WEBHOOK_URL=

# --- Calendly (for "schedule a meeting" flow) ---
CALENDLY_LINK=https://calendly.com/your-blinx-link/intro-call

# --- Server ---
PORT=3000
